{
  "title": "Orka.ai expanded offline RAG robustness evaluation",
  "version": 1,
  "description": "Manually labeled hard paraphrases, out-of-domain negative queries, schema lookup questions, and multi-definition questions. Expected document IDs are based on the current sample warehouse knowledge catalog.",
  "supporting_top_k": 5,
  "schema_top_k": 8,
  "cases": [
    {
      "id": "HARD_CANCELLED_01",
      "category": "hard_paraphrase",
      "question": "Which buyers had purchases voided?",
      "expected_document_ids": [
        "sql_example_customers_with_cancelled_orders",
        "business_cancelled_order"
      ],
      "forbidden_document_ids": []
    },
    {
      "id": "HARD_DISTINCT_01",
      "category": "hard_paraphrase",
      "question": "How many unique catalog items occur on each purchase?",
      "expected_document_ids": [
        "sql_example_distinct_products_per_order"
      ],
      "forbidden_document_ids": []
    },
    {
      "id": "HARD_REVENUE_01",
      "category": "hard_paraphrase",
      "question": "Which merchandise segment generated the most sales dollars?",
      "expected_document_ids": [
        "sql_example_revenue_by_category",
        "business_revenue"
      ],
      "forbidden_document_ids": []
    },
    {
      "id": "HARD_REVENUE_02",
      "category": "hard_paraphrase",
      "question": "Show sales value broken down by product family.",
      "expected_document_ids": [
        "sql_example_revenue_by_category",
        "business_revenue"
      ],
      "forbidden_document_ids": []
    },
    {
      "id": "NEGATIVE_WEATHER",
      "category": "out_of_domain_negative",
      "question": "What is the weather forecast for tomorrow?",
      "expected_document_ids": [],
      "forbidden_document_ids": [
        "sql_example_customers_with_cancelled_orders",
        "sql_example_distinct_products_per_order",
        "sql_example_revenue_by_category"
      ]
    },
    {
      "id": "NEGATIVE_PYTHON",
